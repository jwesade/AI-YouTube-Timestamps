# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string.
# Get it from Supabase Dashboard -> Project Settings -> Database -> Connection string -> "URI"
# Replace [YOUR-PASSWORD] with the DB password you set when creating the project.
# Use the "Transaction" pooler (port 6543) for ingest jobs.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Anthropic direct API key (console.anthropic.com -> API Keys).
# Used by both the 'anthropic' SDK (normalizer) and 'claude-agent-sdk' (research agents).
ANTHROPIC_API_KEY=

# Model override (optional). Defaults to claude-haiku-4-5 for cheap bulk work.
LLM_MODEL=claude-haiku-4-5

# Google Places (needed later for the google_places source)
GOOGLE_PLACES_API_KEY=
